erDiagram
    REFRESH_TOKENS {
        uuid id PK
        uuid user_id "referência ao User Service, sem FK cross-database"
        string token
        timestamptz expires_at
        timestamptz created_at
        boolean revoked
    }
    PASSWORD_RESET_TOKENS {
        uuid id PK
